<% layout('layouts/boilerplate') %>
<%- include('../partials/nav_bar') %>

  <%- include('../partials/flash') %>


  <div class="container">
    
      <div class="card">
        <img src="<%= foundProduct.img %>" alt="<%= foundProduct.name %>">
        <div class="card-body">
          <h3><%= foundProduct.name %></h3>
          <h5>₹<%= foundProduct.price %></h5>
          <p><%= foundProduct.desc %></p>
            <a href="/products/<%=foundProduct._id%>/edit" class="button-link">Edit</a>
            <a href="" class="button-link">Add to Cart</a>
            <a href="" class="button-link">Buy</a>
        </div>
      </div>
      <!-- <> -->
        <h1>Leave a Review</h1>
        <form action="/products/<%= foundProduct._id %>/review" method="POST" class="p-3 border rounded bg-light shadow-sm">

            <div class="mb-3">
              <label class="form-label d-block">Rating</label>
              <fieldset class="starability-basic">
                <legend class="visually-hidden">Star rating</legend>

                <input type="radio" id="no-rate" class="input-no-rate" name="rating" value="0" checked aria-label="No rating." />
                <input type="radio" id="first-rate1" name="rating" value="1" />
                <label for="first-rate1" title="Terrible">1 star</label>
                <input type="radio" id="first-rate2" name="rating" value="2" />
                <label for="first-rate2" title="Not good">2 stars</label>
                <input type="radio" id="first-rate3" name="rating" value="3" />
                <label for="first-rate3" title="Average">3 stars</label>
                <input type="radio" id="first-rate4" name="rating" value="4" />
                <label for="first-rate4" title="Very good">4 stars</label>
                <input type="radio" id="first-rate5" name="rating" value="5" />
                <label for="first-rate5" title="Amazing">5 stars</label>
              </fieldset>
            </div>

            <div class="mb-3">
              <label for="comment" class="form-label">Comment</label>
              <textarea class="form-control" name="comment" id="comment" rows="3" placeholder="Leave your comment..." required></textarea>
            </div>

            <button type="submit" class="btn btn-primary">Add Review</button>
          </form>

        



       <% for(let review of foundProduct.reviews){%>
          <div class="card mt-3" >
          <div class="card-header ">
            <p class="starability-result" data-rating="<%=review.rating %>">
              Rated: <%=review.rating %> stars
            </p></div>
          <div class="card-body">
            <h5 class="card-title">Comment :</h5>
            <p class="card-text"><%=review.comment%></p>
            <!-- <a href="#" class="btn btn-primary">Go somewhere</a> -->
          </div>
          <div class="card-body">
            <% if(review.createdAt){ %>
              <%=review.createdAt.toDateString()%>
            <%}%>
          </div>
        </div>

        <% } %>
      </div>
  </div>
  

</body>
</html>
